{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kuraso.org/schemas/v0.1/structure.schema.json",
  "title": "Kuraso Paper Structure",
  "description": "Stored at <Library>/papers/<slug>/structure.json. All rects use PDF user-space points, unscaled, relative to page CropBox, bottom-left origin, before /Rotate: [x1, y1, x2, y2] with x1 < x2 and y1 < y2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["parserVersion", "coordinateSpace", "pageCount", "headings", "paragraphs", "generatedAt"],
  "properties": {
    "parserVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Incremented when paragraph segmentation heuristics change; prevents silent overwriting"
    },
    "coordinateSpace": {
      "type": "string",
      "const": "pdf-cropbox-points-bl-unrotated"
    },
    "pageCount": {
      "type": "integer",
      "minimum": 1
    },
    "headings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "level", "page", "source"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "level": { "type": "integer", "minimum": 1, "maximum": 6 },
          "page": { "type": "integer", "minimum": 1 },
          "paragraphId": { "type": ["string", "null"], "pattern": "^P[1-9][0-9]*$" },
          "source": { "type": "string", "enum": ["toc", "heuristic", "grobid", "manual"] }
        }
      }
    },
    "paragraphs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "section", "text", "charStart", "charEnd", "anchors"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P[1-9][0-9]*$",
            "description": "Sequential paragraph ID used for AI grounding citations (e.g. P12)"
          },
          "section": { "type": "string" },
          "text": { "type": "string" },
          "charStart": { "type": "integer", "minimum": 0 },
          "charEnd": { "type": "integer", "minimum": 0 },
          "anchors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["page", "rect"],
              "properties": {
                "page": { "type": "integer", "minimum": 1 },
                "rect": {
                  "type": "array",
                  "prefixItems": [
                    { "type": "number" },
                    { "type": "number" },
                    { "type": "number" },
                    { "type": "number" }
                  ],
                  "minItems": 4,
                  "maxItems": 4
                }
              }
            }
          }
        }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  }
}
