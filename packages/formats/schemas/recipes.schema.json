{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kuraso.org/schemas/v1.0/recipes.schema.json",
  "title": "Kuraso Custom AI Summary Recipes",
  "description": "User-saved grounded prompt templates stored in <OS app-data>/Kuraso/recipes.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "recipes"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "promptTemplate"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": ["string", "null"] },
          "promptTemplate": { "type": "string", "minLength": 10 },
          "builtIn": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
