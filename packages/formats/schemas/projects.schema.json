{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kuraso.org/schemas/v1.0/projects.schema.json",
  "title": "Kuraso Research Projects",
  "description": "Stored at <Library>/projects.json. Groups collections and draft notes for a thesis or paper.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "projects"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "collectionIds", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": ["string", "null"] },
          "collectionIds": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "draftMarkdown": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
