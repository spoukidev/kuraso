{
  "name": "kuraso-monorepo",
  "private": true,
  "version": "0.0.1",
  "description": "Kuraso — Open-source, local-first reading workspace for students and researchers",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:formats": "node --test packages/formats/test/*.test.mjs",
    "test:reader": "node --test packages/reader/test/*.test.mjs",
    "test:importers": "node --test packages/importers/test/*.test.mjs",
    "test:annotations": "node --test packages/annotations/test/*.test.mjs",
    "test:ai": "node --test packages/ai/test/*.test.mjs",
    "test:exporters": "node --test packages/exporters/test/*.test.mjs",
    "test:i18n": "node --test apps/desktop/test/*.test.mjs",
    "test:plugins": "node --test packages/plugin-sdk/test/*.test.mjs",
    "test:cli": "node --test packages/cli/test/*.test.mjs",
    "test:all": "npm run test:formats && npm run test:reader && npm run test:importers && npm run test:annotations && npm run test:ai && npm run test:exporters && npm run test:i18n && npm run test:plugins && npm run test:cli",
    "fetch:pdfium": "node scripts/fetch-pdfium.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
