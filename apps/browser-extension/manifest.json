{
  "manifest_version": 3,
  "name": "Save to Kuraso",
  "version": "2.0.0",
  "description": "Send academic papers (arXiv, IEEE, ACM, Springer, DOI pages) straight to your local Kuraso desktop app via kuraso://.",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Kuraso",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
